MONGO_URI=mongodb://127.0.0.1:27017/safety-walk-companion
JWT_SECRET=replace_with_a_long_random_secret
PORT=5000
FRONTEND_URL=http://localhost:5173

# Twilio WhatsApp sender (sandbox example: whatsapp:+14155238886)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace_with_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Optional SMS fallback sender. Use a Twilio number enabled for SMS.
TWILIO_PHONE_NUMBER=+15005550006

# Optional approved Twilio Content template SID for messages outside the 24-hour window.
# Configure the template variables as {{1}} name, {{2}} location URL,
# {{3}} live tracking URL, and {{4}} ISO timestamp.
TWILIO_WHATSAPP_TEMPLATE_SID=

# Optional email alerts used by the existing alert service.
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password
EMAIL_FROM=your_email@gmail.com